SUMMARY:Thursday Sunset Paddle &amp\; Party 
DTSTART;TZID=America/Los_Angeles:20260709T173000
DTEND;TZID=America/Los_Angeles:20260709T200000
UID:13187fe335883b14d50bbf39f1532f3c@thefloathousepetaluma.org
