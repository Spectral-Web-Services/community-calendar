BEGIN:VEVENT
SUMMARY:Free Community Yoga on The Floathouse Dock—First Fridays 
DTSTART;TZID=America/Los_Angeles:20260703T180000
DTEND;TZID=America/Los_Angeles:20260703T190000
UID:5c3a6a74a2520fca017150bf6a549d4e@thefloathousepetaluma.org
