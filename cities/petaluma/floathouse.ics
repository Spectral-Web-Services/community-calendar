SUMMARY:Sunday Funday SUP Paddle 
DTSTART;TZID=America/Los_Angeles:20260517T094500
DTEND;TZID=America/Los_Angeles:20260517T111500
UID:404ad9b946ee366ee0127a03878df3a9@thefloathousepetaluma.org
