 late-x: 0px\; --translate-y: 0px\; --rotation: 0deg\; --scale-x: 100%\; --
 scale-y: 100%\; --skew-x: 0deg\; --skew-y: 0deg\; --origin-x: 50%\; --orig
 in-y: 50%\; opacity: var(--opacity\, 1)\; transform: translateX(var(--tran
