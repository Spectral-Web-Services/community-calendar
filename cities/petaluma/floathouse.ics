 \; border-radius: var(--tweak-text-block-radius)\; } #block-a8f0867bd77e22
 974018 { --tweak-text-block-radius: 0px 0px 0px 0px\; } #block-a8f0867bd77
 e22974018 { } @media screen and (max-width: 767px) { #block-a8f0867bd77e22
