BEGIN:VEVENT
SUMMARY:Thursday Sunset Paddle &amp\; Party
DTSTART;TZID=America/Los_Angeles:20260611T173000
DTEND;TZID=America/Los_Angeles:20260611T194500
UID:78b36a28b93e482d6b4200aaad150276@thefloathousepetaluma.org
ATTACH;FMTTYPE=image/jpeg:https://images.squarespace-cdn.com/content/v1/63
