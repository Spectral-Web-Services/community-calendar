 lock-radius: 0px 0px 0px 0px\; } #block-4395afc7e32b057d4be0 { } @media sc
 reen and (max-width: 767px) { #block-4395afc7e32b057d4be0 { } } @media scr
 een and (max-width: 767px) { #block-4395afc7e32b057d4be0 .sqs-html-content
  { } } @media screen and (max-width: 767px) { } Book my seat! #block-yui_3
 _17_2_1_1779142683378_3189 { --sqs-block-content-flex: 0\; } #block-yui_3_
 17_2_1_1779142683378_3189 { --opacity: 100%\; --translate-x: 0px\; --trans
 late-y: 0px\; --rotation: 0deg\; --scale-x: 100%\; --scale-y: 100%\; --ske
 w-x: 0deg\; --skew-y: 0deg\; --origin-x: 50%\; --origin-y: 50%\; opacity: 
