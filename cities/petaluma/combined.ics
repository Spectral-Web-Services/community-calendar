 radius: 0px 0px 0px 0px\; } #block-yui_3_17_2_1_1778182555900_2116 { } @me
 dia screen and (max-width: 767px) { #block-yui_3_17_2_1_1778182555900_2116
  { } } @media screen and (max-width: 767px) { #block-yui_3_17_2_1_17781825
 55900_2116 .sqs-html-content { } } @media screen and (max-width: 767px) { 
