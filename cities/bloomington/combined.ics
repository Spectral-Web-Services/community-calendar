X-SOURCE-URLS:{"IU Hamilton Lugar School": "https://events.iu.edu/hls/event/2212903-strategic-thinking-in-us-africa-policy-and-intellige", "IU Kelley School of Business": "https://events.iu.edu/live/events/2212903-global-competencies-skills-development-series-how"}
X-SOURCE-URLS:{"IU Hamilton Lugar School": "https://events.iu.edu/hls/event/2212903-strategic-thinking-in-us-africa-policy-and-intellige"}
X-SOURCE-ID:iu_hamilton_lugar
