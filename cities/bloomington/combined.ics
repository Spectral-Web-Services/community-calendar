X-SOURCE:Bloomington Community Farmers' Market, Parks And Rec
DTSTART;TZID=America/New_York:20260404T080000
DTEND;TZID=America/New_York:20260404T123000
RRULE:FREQ=WEEKLY;WKST=SU;UNTIL=20261003T035959Z;BYDAY=SA
