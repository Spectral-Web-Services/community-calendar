X-SOURCE-URLS:{"IU Arts & Humanities Institute": "https://events.iu.edu/live/events/2259790-engs-lecture-2026-the-poison-book-project", "IU Bloomington Libraries": "https://events.iu.edu/libraries/event/2259790-engs-lecture-2026-the-poison-book-project"}
X-SOURCE-URLS:{"IU Arts & Humanities Institute": "https://events.iu.edu/live/events/2259790-engs-lecture-2026-the-poison-book-project"}
X-SOURCE-ID:iu_arts_humanities
