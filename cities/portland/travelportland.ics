BEGIN:VEVENT
SUMMARY:Clackamas ESD Regional Art Show
DTSTART;TZID="UTC-07:00";VALUE=DATE-TIME:20260330T080000
DTEND;TZID="UTC-07:00";VALUE=DATE-TIME:20260330T163000
UID:69b1a1d24291d48891e99654-0@travelportland.com
ATTACH;FMTTYPE=image/jpeg:https://res.cloudinary.com/dragonspell/w_480,h_4
 80,c_fill,g_auto,dpr_auto,fl_progressive:steep/event-images/s3.cruncho.co/
 eventmanager-assets/public/eu-west-1:ced5e211-a717-c800-bfc9-dfa796bc64dc/
 w-600h-600-7418c0-Art_gallery_jpg.png
DESCRIPTION:Celebrate the extraordinary artistic talent of students in the
  region. Each year\, Clackamas ESD presents diverse artwork from middle an
 d high school students representing all 10 Clackamas County school distric
 ts in a juried art show and awards...\n\nPrice: Free
LOCATION:Clackamas Education Service District\, 13455 SE 97th Ave\, Clacka
 mas\, OR 97015
URL:https://www.clackesd.org/artshow/
X-SOURCE:Travel Portland
X-SOURCE-URLS:{"Travel Portland": "https://live-dragonspell.pantheonsite.i
 o/event/69b1a1d24291d48891e99654/"}
