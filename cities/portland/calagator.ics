CREATED;VALUE=DATE-TIME:20260425T050735Z
DTEND;TZID=America/Los_Angeles;VALUE=DATE-TIME:20260505T193000
DTSTART;TZID=America/Los_Angeles;VALUE=DATE-TIME:20260505T180000
